# Copia a .env.local y pega los valores reales. Nunca commitees keys.

# De Supabase → Project Settings → API (proyecto select-hackathon-2026)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=pega-aqui-la-anon-key

# Opcional, solo servidor: permite a la app leer/escribir sin login (demo).
# Consíguela en el mismo panel de API. Sin esto, la app usa la mente local.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: Vercel AI Gateway (https://vercel.com → AI Gateway → API keys).
# Sin esto, los 4 paneles responden en modo demo citando la mente compartida.
AI_GATEWAY_API_KEY=

# Mismo modelo para los 4 paneles; la diferencia es el system prompt + la mente.
AI_GATEWAY_MODEL=anthropic/claude-sonnet-4-5
